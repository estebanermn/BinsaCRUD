@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes ..</h1>
<div class="bd-example">

    <a class="btn btn-success" asp-action="Form">Nuevo</a>
    <button type="button" class="btn btn-light" onclick="edit()">Editar</button>
    <button type="button" class="btn btn-danger" onclick="remove()">Eliminar</button>
    <button type="button" class="btn btn-info" onclick="viewContact()">Ver Contactos</button>

</div>
@if (Model == null || !Model.Any())
{
    <p>No hay contactos registrados para este cliente.</p>
}
else
{
    <table class="table table-hover" id="clientesTable">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Nombre</th>
                <th scope="col">Domicilio</th>
                <th scope="col">Código Postal</th>
                <th scope="col">Población</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-id="@item.Id">
                    <th scope="row">@item.Id</th>
                    <td>@item.Nombre</td>
                    <td>@item.Domicilio</td>
                    <td>@item.CodigoPostal</td>
                    <td>@item.Poblacion</td>

                </tr>
            }

        </tbody>
    </table>

}

@section Scripts {
    <script>
        let selectedId = null;

        document.addEventListener('DOMContentLoaded', ()=>{
            const rows = document.querySelectorAll('#clientesTable tbody tr');

            rows.forEach(row=>{
                row.addEventListener('click', () => {
                    rows.forEach(r => r.classList.remove('table-active'));
                    row.classList.add('table-active');
                      selectedId = row.getAttribute('data-id');
                });
            });
        });

        function edit() {
            if(!selectedId) {
                alert('Seleccione un cliente para editar.');
                return;
            }
             window.location.href = '/Cliente/Form/' + selectedId;
        }

        function remove(){
            if(!selectedId){
                alert('Seleccione un cliente para eliminar.');
                return;
            }
            if(confirm('¿Desea eliminar este cliente?')){
                window.location.href = '/Cliente/Delete/' + selectedId;
            }
        }

        function viewContact(){
            if(!selectedId){
                alert('Seleccione un cliente para ver los contactos.');
                return;
            }
            window.location.href = '/Contacto/Index?clienteId=' + selectedId;
        }



    </script>
}